# Chave da API OpenAI (obrigatória)
# Crie uma cópia como .env e preencha com sua chave
OPENAI_API_KEY="sk-..."

# Chave da API Dev.to (obrigatória para publicar artigos)
# Obtenha em: https://dev.to/settings/account → "DEV Community API Keys"
DEVTO_API_KEY="..."

# Token do Bot do Telegram (obrigatório para usar o bot)
# Obtenha em: https://t.me/BotFather → crie um novo bot
TELEGRAM_BOT_TOKEN="..."
